# Server
PORT=8085
GRPC_PORT=9090

# Database
DATABASE_PATH=./tasks.db

# Queue behavior
AUTO_CREATE_QUEUES=true
DEFAULT_PROJECT=local-project
DEFAULT_LOCATION=us-central1

# Worker
WORKER_CONCURRENCY=10
WORKER_POLL_INTERVAL_MS=500

# Retry
INITIAL_BACKOFF_SECONDS=1
MAX_BACKOFF_SECONDS=60
DEFAULT_MAX_RETRIES=5

# Task execution
TASK_DISPATCH_TIMEOUT_SECS=30

# Scheduler (Cloud Scheduler emulation)
SCHEDULER_ENABLED=true
SCHEDULER_POLL_INTERVAL_MS=1000

# Auth sent to task/job targets as "Authorization: Bearer <token>"
# Static token (e.g. from generate_service_token) - expires when the JWT does:
# SERVICE_ACCOUNT_TOKEN=
# Or let the emulator mint a fresh HS256 token per request (use your backend's JWT secret):
# SERVICE_ACCOUNT_JWT_SECRET=
# SERVICE_ACCOUNT_EMAIL=local-dev@example.com
# SERVICE_ACCOUNT_AUDIENCE=authenticated
